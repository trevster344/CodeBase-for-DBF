{
  "name": "@trevster344/codebase",
  "version": "0.5.0",
  "description": "ESM + CommonJS FFI bindings (with TypeScript types) for the CodeBase native engine (c4dll.dll / c4dll64.dll)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "LGPL-3.0-or-later",
  "author": "trevster344",
  "keywords": [
    "codebase",
    "code4",
    "data4",
    "field4",
    "dbf",
    "dbase",
    "xbase",
    "clipper",
    "foxpro",
    "ffi",
    "koffi",
    "esm",
    "commonjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevster344/CodeBase-for-DBF.git",
    "directory": "interfaces/Node"
  },
  "homepage": "https://github.com/trevster344/CodeBase-for-DBF/tree/dev/interfaces/Node",
  "bugs": {
    "url": "https://github.com/trevster344/CodeBase-for-DBF/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:cjs",
    "build:cjs": "node scripts/build-cjs.mjs",
    "bundle-native": "node scripts/bundle-native.mjs",
    "prepack": "npm run build && npm run bundle-native"
  },
  "dependencies": {
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "koffi@3.3.1": true,
    "esbuild@0.25.12": true
  }
}
